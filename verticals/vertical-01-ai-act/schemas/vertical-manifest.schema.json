{
  "$id": "https://github.com/rian010194/cortxt/schemas/vertical-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Vertical package manifest for harness loading. Contract version 0.1.0.",
  "version": "0.1.0",
  "type": "object",
  "required": [
    "vertical_id",
    "package_version",
    "contract_version",
    "supported_workflows",
    "capability_tags",
    "required_schemas",
    "instructions_index",
    "eval_suite",
    "artifact_policy",
    "non_goals"
  ],
  "properties": {
    "vertical_id": {
      "type": "string",
      "const": "vertical-01-ai-act",
      "description": "Stable vertical identifier."
    },
    "package_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "description": "SemVer of this package."
    },
    "contract_version": {
      "type": "string",
      "description": "Version of the vertical-package contract this manifest obeys."
    },
    "supported_workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "workflow_id",
          "input_schema_uri",
          "output_schema_uri",
          "capability_tags"
        ],
        "properties": {
          "workflow_id": {
            "type": "string"
          },
          "input_schema_uri": {
            "type": "string",
            "format": "uri-reference"
          },
          "output_schema_uri": {
            "type": "string",
            "format": "uri-reference"
          },
          "capability_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "capability_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Required capabilities such as document-reading or structured-output."
    },
    "required_schemas": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri-reference"
      },
      "description": "URIs of schemas the harness must resolve before validating inputs/outputs."
    },
    "instructions_index": {
      "type": "object",
      "description": "Maps instruction_id to file path relative to package root.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "eval_suite": {
      "type": "object",
      "required": [
        "fixture_directory",
        "fixture_schema_uri",
        "minimum_fixture_count"
      ],
      "properties": {
        "fixture_directory": {
          "type": "string"
        },
        "fixture_schema_uri": {
          "type": "string",
          "format": "uri-reference"
        },
        "minimum_fixture_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "artifact_policy": {
      "type": "object",
      "required": [
        "allowed_mime_types",
        "max_size_bytes",
        "retention_class"
      ],
      "properties": {
        "allowed_mime_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "retention_class": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Explicitly deferred capabilities."
    }
  },
  "additionalProperties": false
}