---
// A' site reset, Fase 3 (2026-09-13): new minimal landing page per the
// operator-approved Fase 0.1 content decision — hero (H1 + one-liner +
// 3 CTAs), the live status table (all 8 rows), the Visual Atlas as the
// single visual anchor, and the footer. No Studio, no demo fixtures,
// no install commands, no marketing sections. Static HTML+CSS, one page.
// Theme system preserved: /landing-theme.js (default quiet-slate,
// localStorage-only preview toggle) and landing.css's token bridge.
import '@xyflow/react/dist/style.css';
import '../styles/atlas.css';
import '../styles/landing.css';
import AtlasGraph from '../components/AtlasGraph';

const statusRows = [
  ['Mandate issuance & verification, fail-closed policy gate', 'available', 'Available now'],
  ['GitHub Issues as workflow / evidence authority', 'available', 'Available now'],
  ['cortxt CLI, incl. cortxt mcp serve', 'available', 'Available now'],
  ['Engine adapters (Hermes, Codex, and more behind the same contract)', 'available', 'Available now'],
  ['Single-widget generation by prompt', 'available', 'Available now'],
  ['One bounded continuity scenario across two runs', 'demo', 'Demonstrated proof'],
  ['Cortxt OS / Work, Evidence, Decisions', 'progress', 'In development'],
  ['Prompt-generated multi-widget composition ("Studio")', 'direction', 'Direction'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Cortxt is an operating layer for durable AI work. Agents, models, and providers change; the mandate, state, decisions, and evidence stay attached to the work itself." />
    <title>Cortxt | An operating layer for durable AI work</title>
    <!--
      Issue #377: the public landing page renders a fixed default preset
      (quiet-slate) for every visitor, independent of whatever preset an
      operator last resolved server-side via `cortxt theme use` -- that is
      what /theme-tokens.js applies on every other page. The landing page
      intentionally does NOT load /theme-tokens.js; landing-theme.js below
      applies quiet-slate by default and offers a client-side,
      localStorage-only toggle across all three presets with no
      server-side visitor-preference persistence.
    -->
    <script src="/landing-theme.js" is:inline></script>
  </head>
  <body>
    <header class="nav shell">
      <a class="brand" href="/" aria-label="Cortxt home"><span>C</span>Cortxt</a>
      <nav aria-label="Primary navigation">
        <a href="/workspace/">Home</a><a href="/docs/">Docs</a><a href="/atlas/">Atlas</a><a href="/widgets/">Cortxt OS</a>
        <div class="theme-toggle" id="theme-toggle" role="group" aria-label="Preview color theme (this browser only)">
          <button type="button" data-preset="quiet-slate" class="active" title="Quiet Slate">&nbsp;</button>
          <button type="button" data-preset="graphite-ink" title="Graphite Ink">&nbsp;</button>
          <button type="button" data-preset="soft-dusk" title="Soft Dusk">&nbsp;</button>
        </div>
        <a class="nav-cta" href="https://github.com/rian010194/cortxt">GitHub</a>
      </nav>
    </header>
    <main>
      <section class="hero shell">
        <p class="eyebrow"><i></i> Cortxt</p>
        <h1>An operating layer for durable AI&nbsp;work.</h1>
        <p class="lede">AI execution changes. Your work shouldn&rsquo;t have to start over.</p>
        <div class="actions">
          <a class="primary" href="/docs/">Read the docs</a>
          <a class="secondary-cta" href="/atlas/">See the atlas</a>
          <a class="secondary" href="https://github.com/rian010194/cortxt">GitHub <span aria-hidden="true">-&gt;</span></a>
        </div>
      </section>

      <section class="atlas-band shell" aria-labelledby="atlas-title">
        <p class="eyebrow">Visual Atlas</p>
        <h2 id="atlas-title">The roadmap as a graph &mdash; issues, blockers, milestones, and the actionable&nbsp;frontier.</h2>
        <div class="landing-atlas">
          <AtlasGraph client:load />
        </div>
        <p class="atlas-note">Derived from the GitHub issue record. <a href="/atlas/">Open the full atlas -&gt;</a></p>
      </section>

      <section class="status-band shell" aria-labelledby="status-title">
        <p class="eyebrow">Where things stand</p>
        <h2 id="status-title">What&rsquo;s real today, and what&rsquo;s direction.</h2>
        <div class="status-table-wrap">
          <table class="status-table">
            <thead><tr><th scope="col">Layer</th><th scope="col">Status</th></tr></thead>
            <tbody>
              {statusRows.map(([label, cls, text]) => (
                <tr><td>{label}</td><td><span class={`status-tag ${cls}`}>{text}</span></td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </main>
    <footer class="site-footer shell"><a class="brand" href="/"><span>C</span>Cortxt</a><span>Human mandate. Verifiable work.</span><span class="footer-links"><a href="/privacy/">Privacy</a><a href="/docs/">Documentation -&gt;</a></span></footer>
  </body>
</html>
