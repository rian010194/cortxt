{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "architecture-diagram-wrapper Input",
  "type": "object",
  "required": [
    "action",
    "resource",
    "params",
    "context"
  ],
  "properties": {
    "action": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    },
    "params": {
      "type": "object"
    },
    "context": {
      "type": "object",
      "required": [
        "run_id",
        "agent_id",
        "trace_id",
        "priority"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "normal",
            "high",
            "low"
          ]
        },
        "timeout_ms": {
          "type": "integer"
        }
      }
    }
  }
}